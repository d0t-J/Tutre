# Tutre — local environment template. Copy to `.env` and fill in real values.
# `.env` is git-ignored; this template is tracked. Never put a service-role key here.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable (new-style) key. Preferred — the app checks this first.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key. Used as a fallback if PUBLISHABLE_KEY is unset.
VITE_SUPABASE_ANON_KEY=

# WhatsApp delivery of study guides. Off unless exactly "true"; the send-whatsapp
# Edge Function must also have its WHATSAPP_ENABLED secret set to "true".
VITE_ENABLE_WHATSAPP=false
